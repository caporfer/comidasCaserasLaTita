---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Azulejo from '../components/Azulejo.astro';
import Pizarra from '../components/Pizarra.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Carta from '../components/Carta.astro';
import Historia from '../components/Historia.astro';
import Resenas from '../components/Resenas.astro';
import Bandejas from '../components/Bandejas.astro';
import Visitanos from '../components/Visitanos.astro';
import Footer from '../components/Footer.astro';
import BarraMovil from '../components/BarraMovil.astro';
---

<Base>
  <Header />
  <main id="contenido">
    <Hero />
    <Azulejo />
    <Pizarra />
    <ComoFunciona />
    <Carta />
    <Historia />
    <Resenas />
    <Bandejas />
    <Visitanos />
  </main>
  <Footer />
  <BarraMovil />
</Base>
