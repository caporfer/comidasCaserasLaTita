---
// Cenefa de azulejo de zócalo andaluz dibujada en SVG (sin imágenes externas).
interface Props {
  alto?: number;
  class?: string;
}
const { alto = 44, class: clase } = Astro.props;
const id = `az-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['cenefa', clase]} style={`--alto:${alto}px`} aria-hidden="true">
  <svg width="100%" height={alto} preserveAspectRatio="none">
    <defs>
      <pattern id={id} width={alto} height={alto} patternUnits="userSpaceOnUse">
        <g transform={`scale(${alto / 48})`}>
          <rect width="48" height="48" fill="var(--blanco)" />
          <rect x="1" y="1" width="46" height="46" fill="none" stroke="var(--persiana)" stroke-width="2" />
          <!-- cuartos de flor en las esquinas: al juntarse forman una flor -->
          <g fill="var(--persiana)">
            <path d="M0 0h13a13 13 0 0 1-13 13Z" />
            <path d="M48 0H35a13 13 0 0 0 13 13Z" />
            <path d="M0 48h13a13 13 0 0 0-13-13Z" />
            <path d="M48 48H35a13 13 0 0 1 13-13Z" />
          </g>
          <!-- rombo central de albero con corazón de geranio -->
          <path d="M24 8 40 24 24 40 8 24Z" fill="var(--albero)" />
          <path d="M24 14 34 24 24 34 14 24Z" fill="none" stroke="var(--persiana)" stroke-width="1.6" />
          <circle cx="24" cy="24" r="4.2" fill="var(--geranio)" />
          <g fill="var(--geranio)">
            <circle cx="24" cy="3.5" r="1.6" />
            <circle cx="24" cy="44.5" r="1.6" />
            <circle cx="3.5" cy="24" r="1.6" />
            <circle cx="44.5" cy="24" r="1.6" />
          </g>
        </g>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${id})`} />
  </svg>
</div>

<style>
  .cenefa {
    height: var(--alto);
    border-block: 3px solid var(--tinta);
    background: var(--persiana);
    overflow: hidden;
  }
  .cenefa svg {
    display: block;
  }
</style>
