---
interface Props {
  claro?: boolean;
}
const { claro = false } = Astro.props;
---

<span class:list={['logo', { claro }]}>
  <svg class="olla" viewBox="0 0 64 56" aria-hidden="true">
    <path d="M22 14c3-5-2-7 1-12M32 14c3-5-2-7 1-12M42 14c3-5-2-7 1-12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
    <path d="M6 22h52" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
    <path d="M10 24h44v14a14 14 0 0 1-14 14H24a14 14 0 0 1-14-14V24Z" fill="var(--almagra)" stroke="currentColor" stroke-width="3" />
    <path d="M10 30H3M54 30h7" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
    <path d="M18 34c5 3 23 3 28 0" fill="none" stroke="var(--crema)" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="1 5" />
  </svg>
  <span class="letras">
    <span class="nombre">La Tita</span>
    <span class="apellido">comidas caseras · Huelva</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--tinta);
  }
  .logo.claro {
    color: var(--crema);
  }
  .olla {
    width: 44px;
    height: auto;
    flex: none;
    margin-top: -6px;
  }
  .letras {
    display: grid;
    line-height: 1;
  }
  .nombre {
    font-family: var(--f-titulo);
    font-size: 1.75rem;
    letter-spacing: -0.02em;
  }
  .apellido {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-top: 3px;
    white-space: nowrap;
  }
  @media (max-width: 420px) {
    .apellido {
      letter-spacing: 0.06em;
      font-size: 0.66rem;
    }
  }
</style>
