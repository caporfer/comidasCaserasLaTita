---
// Barra fija abajo en el móvil: llamar, WhatsApp y el encargo en curso.
import Icono from './Icono.astro';
import { telLink, waLink } from '../data/negocio';
---

<nav class="barra" aria-label="Acciones rápidas">
  <a href={telLink}><Icono nombre="telefono" /><span>Llamar</span></a>
  <a href={waLink('¡Hola Tita!')} target="_blank" rel="noopener" class="wa"><Icono nombre="whatsapp" /><span>WhatsApp</span></a>
  <a href="#encargo" class="mi-encargo">
    <Icono nombre="bolsa" /><span>Mi encargo</span>
    <span class="contador" data-contador hidden>0</span>
  </a>
</nav>

<script>
  const contador = document.querySelector<HTMLElement>('[data-contador]');
  window.addEventListener('encargo:cambio', (e) => {
    const total = (e as CustomEvent<{ total: number }>).detail.total;
    if (!contador) return;
    contador.textContent = String(total);
    contador.hidden = total === 0;
  });
</script>

<style>
  .barra {
    position: fixed;
    left: 10px;
    right: 10px;
    bottom: calc(10px + env(safe-area-inset-bottom));
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr 1.3fr 1fr;
    background: var(--tinta);
    border-radius: 18px;
    padding: 6px;
    gap: 6px;
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.5);
  }
  .barra a {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 2px;
    padding: 8px 4px;
    color: var(--papel);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    border-radius: 12px;
  }
  .barra :global(svg) {
    width: 22px;
    height: 22px;
  }
  .barra .wa {
    background: var(--wa);
    color: #fff;
  }
  .contador {
    position: absolute;
    top: 2px;
    right: calc(50% - 26px);
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 10px;
    background: var(--mostaza);
    color: var(--tinta);
    font-size: 0.75rem;
    line-height: 20px;
    text-align: center;
  }
  @media (min-width: 861px) {
    .barra {
      display: none;
    }
  }
</style>
