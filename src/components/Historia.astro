---
import { negocio } from '../data/negocio';
const nota = negocio.valoracion.nota.toLocaleString('es-ES');
---

<section class="seccion historia" id="la-tita" aria-labelledby="historia-titulo">
  <div class="envoltorio rejilla">
    <div class="texto">
      <p class="antetitulo">de freiduría a cocina de barrio</p>
      <h2 id="historia-titulo">
        <span class="numero">{negocio.anyos}</span>
        <span class="resto">años dando de comer a Hermano Palomo</span>
      </h2>
      <p>
        La Tita empezó como freiduría, y de ahí viene lo que todavía hoy le piden por docenas: croquetas,
        empanadillas y flamenquines empanados a mano, uno a uno.
      </p>
      <p>
        Con los años, a la freidora le salieron compañeras: ollas de lentejas, de puchero, de garbanzos… y una
        tortilla de patatas que ya forma parte del barrio. Hoy hay vecinos que comen de la Tita varias veces por
        semana y familias que no conciben un cumpleaños sin su bandeja de croquetas.
      </p>
      <p>
        Esto no es un restaurante. Es la comida de casa para cuando en casa no da tiempo.
      </p>
      <p class="receta mano">
        Receta de la casa: buen aceite, fuego lento y ninguna prisa.
      </p>
    </div>

    <figure class="tienda">
      <svg viewBox="0 0 420 400" role="img" aria-labelledby="tienda-t">
        <title id="tienda-t">Dibujo de la fachada de La Tita, con su toldo de rayas y la pizarra en la puerta</title>
        <g stroke="#2b211a" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
          <!-- fachada -->
          <path d="M30 70h360v310H30z" fill="#f7efdc" />
          <path d="M30 330h360" fill="none" />
          <!-- zócalo de azulejo -->
          <g>
            <rect x="30" y="330" width="360" height="50" fill="#1d4a86" />
            <path d="M30 355h360M66 330v50M102 330v50M138 330v50M174 330v50M210 330v50M246 330v50M282 330v50M318 330v50M354 330v50" stroke="#f7efdc" stroke-width="1.6" />
          </g>
          <!-- cartel -->
          <rect x="70" y="20" width="280" height="62" rx="6" fill="#a13d25" />
          <text x="210" y="60" text-anchor="middle" font-family="Young Serif, Georgia, serif" font-size="34" fill="#fbf6ea" stroke="none">La Tita</text>
          <text x="210" y="76" text-anchor="middle" font-family="Figtree, sans-serif" font-weight="800" font-size="9" letter-spacing="3" fill="#fbf6ea" stroke="none">COMIDAS CASERAS</text>
          <!-- toldo -->
          <path d="M40 100h340l-14 46H54z" fill="#fbf6ea" />
          <g fill="#a13d25" stroke="none">
            <path d="M40 100h34l-4 46H54zM108 100h34l-2 46h-30zM176 100h34v46h-34zM244 100h34l2 46h-34zM312 100h34l6 46h-34z" />
          </g>
          <path d="M40 100h340l-14 46H54z" fill="none" />
          <path d="M54 146q12 14 24 0q12 14 24 0q12 14 24 0q12 14 24 0q12 14 24 0q12 14 24 0q12 14 24 0q12 14 24 0q12 14 24 0q12 14 24 0q12 14 24 0q12 14 24 0q12 12 18 0" fill="#fbf6ea" />
          <!-- escaparate -->
          <rect x="54" y="176" width="170" height="140" fill="#cfe0ef" />
          <path d="M139 176v140" />
          <path d="M70 196l30-10M160 210l40-14" stroke="#fff" stroke-width="4" opacity=".8" />
          <!-- ollas en el escaparate -->
          <path d="M70 300h54v-20a6 6 0 0 0-6-6H76a6 6 0 0 0-6 6z" fill="#a13d25" />
          <path d="M150 300h60v-26H150z" fill="#dfa52a" />
          <path d="M160 274c-2-10 6-12 4-20M180 274c-2-10 6-12 4-20" fill="none" stroke-width="2" />
          <!-- puerta -->
          <rect x="250" y="170" width="110" height="160" fill="#5f6b34" />
          <rect x="266" y="186" width="78" height="70" fill="#cfe0ef" />
          <circle cx="342" cy="262" r="4" fill="#dfa52a" />
          <!-- pizarra de pie -->
          <path d="M214 380l20-86h56l20 86" fill="none" stroke-width="4" />
          <rect x="226" y="290" width="72" height="70" rx="2" fill="#252d28" />
          <path d="M236 306h40M236 320h52M236 334h30M236 348h44" stroke="#f2eee4" stroke-width="2" opacity=".85" />
          <!-- maceta -->
          <path d="M366 380l6-34h26l6 34z" fill="#a13d25" />
          <path d="M385 346c-10-20-24-18-30-30M385 346c4-24 16-30 22-40M385 346c-2-18 -8-28-4-44" fill="none" stroke="#5f6b34" stroke-width="3" />
        </g>
      </svg>
      <figcaption class="mano">C. Hermano Palomo, Huelva</figcaption>
    </figure>
  </div>

  <div class="envoltorio">
    <ul class="cifras">
      <li><strong>{negocio.anyos}</strong><span>años en el barrio</span></li>
      <li><strong>{nota}★</strong><span>de media en Google</span></li>
      <li><strong>{negocio.valoracion.resenas}</strong><span>reseñas de vecinos</span></li>
      <li><strong>{negocio.precioPorPersona}</strong><span>por persona</span></li>
    </ul>
  </div>
</section>

<style>
  .historia {
    background: var(--azulejo);
    color: var(--crema);
    border-block: 3px solid var(--tinta);
    overflow: hidden;
  }
  .historia::before {
    /* marca de agua de azulejo */
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.07;
    background:
      radial-gradient(circle at 0 0, #fff 18%, transparent 19%) 0 0 / 60px 60px,
      radial-gradient(circle at 100% 100%, #fff 18%, transparent 19%) 0 0 / 60px 60px,
      radial-gradient(circle at 50% 50%, #fff 12%, transparent 13%) 0 0 / 60px 60px;
    pointer-events: none;
  }
  .rejilla {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
    position: relative;
  }
  .antetitulo {
    color: var(--mostaza);
  }
  h2 {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 18px;
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    margin-bottom: 28px;
  }
  .numero {
    font-size: clamp(6rem, 14vw, 10rem);
    line-height: 0.8;
    color: var(--mostaza);
    text-shadow: 5px 5px 0 var(--tinta);
  }
  .texto p:not(.antetitulo):not(.receta) {
    color: rgba(251, 246, 234, 0.9);
    max-width: 52ch;
  }
  .receta {
    font-size: 1.9rem;
    max-width: 24ch;
    color: var(--mostaza);
    transform: rotate(-2deg);
    margin-top: 24px;
  }
  .tienda {
    margin: 0;
    background: var(--crema);
    padding: 18px 18px 6px;
    border: 3px solid var(--tinta);
    box-shadow: 10px 10px 0 var(--tinta);
    transform: rotate(1.5deg);
  }
  .tienda figcaption {
    color: var(--tinta);
    text-align: center;
    font-size: 1.5rem;
    padding: 6px 0;
  }
  .cifras {
    list-style: none;
    padding: 0;
    margin: clamp(48px, 7vw, 80px) 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 2px dashed rgba(251, 246, 234, 0.4);
    position: relative;
  }
  .cifras li {
    padding: 24px 12px 0;
    display: grid;
    gap: 2px;
  }
  .cifras strong {
    font-family: var(--f-titulo);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1;
  }
  .cifras span {
    font-size: 0.95rem;
    opacity: 0.85;
  }
  @media (max-width: 900px) {
    .rejilla {
      grid-template-columns: minmax(0, 1fr);
    }
    .tienda {
      max-width: 480px;
    }
    .cifras {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 12px;
    }
  }
</style>
