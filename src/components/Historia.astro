---
import { negocio } from '../data/negocio';
const nota = negocio.valoracion.nota.toLocaleString('es-ES');
---

<section class="seccion historia" id="la-tita" aria-labelledby="historia-titulo">
  <div class="envoltorio rejilla">
    <div class="texto">
      <p class="antetitulo">de freiduría a cocina de barrio</p>
      <h2 id="historia-titulo">
        <span class="numero">{negocio.anyos}</span>
        <span class="resto">años dando de comer a Hermano Palomo</span>
      </h2>
      <p>
        La Tita empezó como freiduría, y de ahí viene lo que todavía hoy le piden por docenas: croquetas,
        empanadillas y flamenquines empanados a mano, uno a uno.
      </p>
      <p>
        Con los años, a la freidora le salieron compañeras: ollas de lentejas, de puchero, de garbanzos… y una
        tortilla de patatas que ya forma parte del barrio. Hoy hay vecinos que comen de la Tita varias veces por
        semana y familias que no conciben un cumpleaños sin su bandeja de croquetas.
      </p>
      <p>
        Esto no es un restaurante. Es la comida de casa para cuando en casa no da tiempo.
      </p>
      <p class="receta mano">
        Receta de la casa: buen aceite, fuego lento y ninguna prisa.
      </p>
    </div>

    <figure class="tienda">
      <svg viewBox="0 0 420 400" role="img" aria-labelledby="tienda-t">
        <title id="tienda-t">Dibujo de la fachada encalada de La Tita, con persianas verdes, zócalo de albero y geranios</title>
        <g stroke="var(--tinta)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
          <!-- pared encalada -->
          <path d="M20 60h380v320H20z" fill="var(--blanco)" />
          <!-- zócalo de albero -->
          <rect x="20" y="326" width="380" height="54" fill="var(--albero)" />
          <path d="M20 334h380" stroke-width="1.5" opacity=".5" />

          <!-- rótulo pintado -->
          <rect x="95" y="14" width="230" height="58" rx="5" fill="var(--persiana)" />
          <rect x="102" y="21" width="216" height="44" rx="3" fill="none" stroke="var(--albero)" stroke-width="2" />
          <text x="210" y="52" text-anchor="middle" font-family="Alfa Slab One, Rockwell, serif" font-size="27" fill="var(--blanco)" stroke="none">LA TITA</text>

          <!-- toldo a rayas -->
          <path d="M40 92h200l-10 40H50z" fill="var(--blanco)" />
          <g fill="var(--geranio)" stroke="none">
            <path d="M40 92h25l-3 40H50zM90 92h25l-1 40H91zM140 92h25v40h-25zM190 92h25l2 40h-25z" />
          </g>
          <path d="M40 92h200l-10 40H50z" fill="none" />
          <path d="M50 132q10 12 20 0q10 12 20 0q10 12 20 0q10 12 20 0q10 12 20 0q10 12 20 0q10 12 20 0q10 12 20 0q10 12 20 0" fill="var(--blanco)" />

          <!-- escaparate con ollas -->
          <rect x="52" y="160" width="176" height="150" fill="var(--persiana-claro)" />
          <path d="M140 160v150" />
          <path d="M66 180l30-10M156 192l40-14" stroke="var(--blanco)" stroke-width="4" opacity=".9" />
          <path d="M68 296h54v-20a6 6 0 0 0-6-6H74a6 6 0 0 0-6 6z" fill="var(--geranio)" />
          <path d="M154 296h60v-26h-60z" fill="var(--albero)" />
          <path d="M166 270c-2-10 6-12 4-20M188 270c-2-10 6-12 4-20" fill="none" stroke-width="2" />
          <!-- repisa -->
          <path d="M44 310h192" stroke-width="5" />

          <!-- puerta con persiana verde -->
          <rect x="262" y="150" width="112" height="176" fill="var(--persiana)" />
          <g stroke="var(--persiana-osc)" stroke-width="2">
            <path d="M270 166h96M270 176h96M270 186h96M270 196h96M270 206h96M270 216h96M270 226h96M270 236h96" />
          </g>
          <rect x="270" y="252" width="96" height="66" fill="var(--persiana-osc)" />
          <circle cx="360" cy="286" r="4" fill="var(--albero)" />

          <!-- macetas de geranios en la fachada -->
          <g>
            <path d="M292 120h40l-4 18h-32z" fill="var(--geranio-osc)" />
            <path d="M302 120c-8-12-2-20 6-16M312 120c0-14 8-18 12-12M322 120c6-10 14-8 12 0" fill="none" stroke="var(--persiana)" stroke-width="2.5" />
            <g fill="var(--geranio)" stroke-width="2">
              <circle cx="304" cy="102" r="6" /><circle cx="318" cy="96" r="7" /><circle cx="332" cy="104" r="6" />
            </g>
            <path d="M270 112h96" stroke-width="2" opacity=".6" />
            <path d="M276 100v12M360 100v12" stroke-width="2" opacity=".6" />
          </g>

          <!-- pizarra de pie -->
          <path d="M196 380l18-78h52l18 78" fill="none" stroke-width="4" />
          <rect x="206" y="296" width="68" height="66" rx="2" fill="var(--pizarra)" />
          <path d="M216 312h36M216 326h48M216 340h28M216 352h40" stroke="var(--tiza)" stroke-width="2" opacity=".85" />

          <!-- maceta a pie de calle -->
          <path d="M28 380l6-30h30l6 30z" fill="var(--geranio-osc)" />
          <path d="M49 350c-8-16-2-26 8-22M49 350c2-16 12-20 18-12" fill="none" stroke="var(--persiana)" stroke-width="2.5" />
          <g fill="var(--geranio)" stroke-width="2"><circle cx="44" cy="330" r="7" /><circle cx="60" cy="334" r="6" /></g>
        </g>
      </svg>
      <figcaption class="mano">C. Hermano Palomo, Huelva</figcaption>
    </figure>
  </div>

  <div class="envoltorio">
    <ul class="cifras">
      <li><strong>{negocio.anyos}</strong><span>años en el barrio</span></li>
      <li><strong>{nota}★</strong><span>de media en Google</span></li>
      <li><strong>{negocio.valoracion.resenas}</strong><span>reseñas de vecinos</span></li>
      <li><strong>{negocio.precioPorPersona}</strong><span>por persona</span></li>
    </ul>
  </div>
</section>

<style>
  .historia {
    background: var(--persiana);
    color: var(--blanco);
    border-block: 3px solid var(--tinta);
    overflow: hidden;
  }
  .historia::before {
    /* lamas de persiana */
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      180deg,
      transparent 0 22px,
      rgb(0 0 0 / 0.08) 22px 24px,
      rgb(255 255 255 / 0.04) 24px 26px
    );
    pointer-events: none;
  }
  .rejilla {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
    position: relative;
  }
  .antetitulo {
    color: var(--albero);
  }
  h2 {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 18px;
    font-size: clamp(1.45rem, 2.8vw, 2.1rem);
    margin-bottom: 28px;
  }
  .numero {
    font-size: clamp(5rem, 11vw, 8rem);
    line-height: 0.8;
    color: var(--albero);
    text-shadow: 5px 5px 0 var(--tinta);
  }
  .texto p:not(.antetitulo):not(.receta) {
    color: rgb(253 252 248 / 0.92);
    max-width: 52ch;
  }
  .receta {
    font-size: 1.45rem;
    max-width: 24ch;
    color: var(--albero-claro);
    transform: rotate(-2deg);
    margin-top: 24px;
  }
  .tienda {
    margin: 0;
    background: var(--blanco);
    padding: 18px 18px 6px;
    border: 3px solid var(--tinta);
    box-shadow: 10px 10px 0 var(--tinta);
    transform: rotate(1.5deg);
  }
  .tienda figcaption {
    color: var(--tinta);
    text-align: center;
    font-size: 1.15rem;
    padding: 8px 0 6px;
  }
  .cifras {
    list-style: none;
    padding: 0;
    margin: clamp(48px, 7vw, 80px) 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 2px dashed rgb(253 252 248 / 0.4);
    position: relative;
  }
  .cifras li {
    padding: 24px 12px 0;
    display: grid;
    gap: 4px;
  }
  .cifras strong {
    font-family: var(--f-titulo);
    font-weight: 400;
    font-size: clamp(1.8rem, 3.4vw, 2.5rem);
    line-height: 1;
    color: var(--albero);
  }
  .cifras span {
    font-size: 0.95rem;
    opacity: 0.9;
  }
  @media (max-width: 900px) {
    .rejilla {
      grid-template-columns: minmax(0, 1fr);
    }
    .tienda {
      max-width: 480px;
    }
    .cifras {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 12px;
    }
  }
</style>
