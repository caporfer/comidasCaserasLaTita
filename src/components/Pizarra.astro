---
import Icono from './Icono.astro';
import { menuSemana } from '../data/menuSemana';
import { DIAS, waLink } from '../data/negocio';

const orden = [1, 2, 3, 4, 5, 6, 0];
---

<section class="seccion pizarra-sec" id="hoy">
  <div class="envoltorio rejilla">
    <div class="marco">
      <div class="pizarra">
        {
          orden.map((d) => {
            const m = menuSemana[d];
            return (
              <div class="dia-menu" data-dia={d}>
                <p class="tiza-titulo">Hoy, {DIAS[d]}</p>
                <dl>
                  <dt>De cuchara</dt>
                  <dd>{m.guiso}</dd>
                  <dt>De segundo</dt>
                  <dd>{m.segundo}</dd>
                  <dt>Y de postre</dt>
                  <dd>{m.postre}</dd>
                </dl>
                {m.aviso && <p class="aviso">({m.aviso})</p>}
                <a
                  class="boton boton--claro guardame"
                  href={waLink(`¡Hola Tita! ¿Me guardas una ración de ${m.guiso.toLowerCase()} para hoy ${DIAS[d]}? Paso a recogerla sobre las `)}
                  target="_blank"
                  rel="noopener"
                >
                  <Icono nombre="whatsapp" /> Guárdame una ración
                </a>
              </div>
            );
          })
        }
        <svg class="garabato g1" viewBox="0 0 80 60" aria-hidden="true">
          <path d="M10 40c10-25 50-25 60 0M6 40h68M22 20c2-6-2-8 0-14M40 16c2-6-2-8 0-14M58 20c2-6-2-8 0-14" />
        </svg>
        <svg class="garabato g2" viewBox="0 0 60 60" aria-hidden="true">
          <path d="M30 6l6 16 17 1-13 11 5 17-15-10-15 10 5-17L7 23l17-1Z" />
        </svg>
        <span class="borrado" aria-hidden="true"></span>
      </div>
      <span class="tiza-pieza" aria-hidden="true"></span>
    </div>

    <div class="explicacion">
      <p class="antetitulo">la pizarra de la puerta</p>
      <h2>¿Qué hay hoy, Tita?</h2>
      <p>
        La pregunta de todos los días. Cada mañana la Tita pone en la pizarra lo que tiene en los fogones.
        Aquí tienes la semana tipo; lo de hoy va en la pizarra.
      </p>
      <ol class="semana">
        {
          orden.map((d) => (
            <li data-dia={d}>
              <span class="nombre-dia">{DIAS[d]}</span>
              <span class="plato-dia">{menuSemana[d].guiso}</span>
            </li>
          ))
        }
      </ol>
      <p class="letra-pequena">
        Es orientativo: lo que se cocina depende del mercado y de lo que pida el cuerpo. Si vas a tiro fijo,
        pregunta antes por WhatsApp.
      </p>
    </div>
  </div>
</section>

<style>
  .pizarra-sec {
    background: var(--cal-2);
    border-bottom: 3px solid var(--tinta);
    /* zócalo de albero al pie de la pared */
    box-shadow: inset 0 -22px 0 var(--albero), inset 0 -25px 0 var(--tinta);
    padding-bottom: calc(clamp(64px, 10vw, 120px) + 22px);
  }
  .rejilla {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .marco {
    position: relative;
    padding: 18px;
    border-radius: 6px;
    /* marco de madera pintada de verde persiana, algo desconchado */
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.05) 0 3px, transparent 3px 11px),
      linear-gradient(135deg, var(--persiana), var(--persiana-osc) 45%, var(--persiana) 70%, var(--persiana-osc));
    box-shadow: 0 24px 40px -20px rgb(var(--tinta-rgb) / 0.6), inset 0 0 0 2px rgb(0 0 0 / 0.25);
    transform: rotate(-1.2deg);
  }
  .pizarra {
    position: relative;
    min-height: 420px;
    padding: clamp(24px, 4vw, 44px);
    color: var(--tiza);
    background: radial-gradient(ellipse at 30% 20%, #323b36 0%, var(--pizarra) 60%, #181d1a 100%);
    border-radius: 2px;
    overflow: hidden;
    box-shadow: inset 0 0 40px rgb(0 0 0 / 0.5);
  }
  .borrado {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 40% 18% at 70% 85%, rgb(255 255 255 / 0.06), transparent 70%),
      radial-gradient(ellipse 30% 12% at 20% 60%, rgb(255 255 255 / 0.05), transparent 70%);
  }
  .dia-menu {
    display: none;
    position: relative;
    z-index: 1;
  }
  .dia-menu[data-hoy] {
    display: block;
  }
  /* sin JavaScript se ve el lunes */
  .pizarra:not(:has([data-hoy])) .dia-menu[data-dia='1'] {
    display: block;
  }
  .tiza-titulo {
    font-family: var(--f-mano);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.1;
    margin: 0 0 18px;
    text-decoration: underline wavy rgb(244 241 232 / 0.5) 2px;
    text-underline-offset: 12px;
  }
  .tiza-titulo::first-letter {
    color: var(--albero);
  }
  dl {
    margin: 0;
    font-family: var(--f-mano);
  }
  dt {
    font-size: 1rem;
    color: var(--albero-claro);
    margin-top: 16px;
    opacity: 0.9;
  }
  dd {
    margin: 2px 0 0;
    font-size: clamp(1.45rem, 2.7vw, 1.95rem);
    font-weight: 400;
    line-height: 1.15;
    /* trazo de tiza: bordes algo difusos */
    text-shadow: 0 0 1px rgb(255 255 255 / 0.5), 0 0 6px rgb(255 255 255 / 0.12);
  }
  .aviso {
    font-family: var(--f-mano);
    font-size: 1rem;
    color: var(--albero-claro);
    margin: 10px 0 0;
  }
  .guardame {
    margin-top: 26px;
  }
  .garabato {
    position: absolute;
    fill: none;
    stroke: rgb(244 241 232 / 0.55);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .g1 {
    width: 90px;
    right: 26px;
    top: 26px;
  }
  .g2 {
    width: 44px;
    right: 48px;
    bottom: 36px;
    stroke: var(--albero);
    opacity: 0.8;
  }
  .tiza-pieza {
    position: absolute;
    bottom: 6px;
    left: 18%;
    width: 46px;
    height: 10px;
    border-radius: 3px;
    background: var(--tiza);
    box-shadow: 0 2px 2px rgb(0 0 0 / 0.3);
    transform: rotate(-4deg);
  }

  .semana {
    list-style: none;
    padding: 0;
    margin: 24px 0;
    border-top: 2px solid var(--tinta);
  }
  .semana li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 4px;
    border-bottom: 1px dashed rgb(var(--tinta-rgb) / 0.35);
  }
  .nombre-dia {
    text-transform: capitalize;
    font-weight: 600;
    min-width: 6ch;
  }
  .plato-dia {
    color: var(--tinta-suave);
    text-align: right;
  }
  .semana li[data-hoy] {
    background: var(--albero);
    font-weight: 700;
    border-radius: 3px;
    padding-inline: 10px;
  }
  .semana li[data-hoy] .plato-dia {
    color: var(--tinta);
  }
  .semana li[data-hoy] .nombre-dia::after {
    content: ' · hoy';
    font-family: var(--f-mano);
    font-weight: 400;
    font-size: 0.95rem;
    text-transform: none;
  }
  .letra-pequena {
    font-size: 0.92rem;
    color: var(--tinta-suave);
  }
  @media (max-width: 900px) {
    .rejilla {
      grid-template-columns: minmax(0, 1fr);
    }
    .explicacion {
      order: -1;
    }
    .pizarra {
      min-height: 360px;
    }
  }
</style>
